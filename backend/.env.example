# Copy to backend/.env and adjust.
# DATABASE_URL=postgresql+psycopg://mandi:mandi@localhost:5432/mandi
# Answer writer: auto | anthropic | gemini | groq | openrouter | ollama | none.
# auto uses Claude when ANTHROPIC_API_KEY is set, otherwise the first free key below,
# otherwise the offline templates. Ollama (local) is opt-in.
LLM_ENABLED=true
LLM_PROVIDER=auto
# Free: Google AI Studio key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Free: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Free ":free" models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Seconds a hosted LLM gets to write one answer; past it the built-in writer answers instantly
LLM_DEADLINE_S=15
TOOL_BUDGET=6
STALE_AFTER_DAYS=3
# Pin "today" for demos against a fixed dataset (YYYY-MM-DD); empty = real date.
AS_OF_OVERRIDE=
# data.gov.in dataset: 35985678-... is "Variety-wise Daily Market Prices" (updated reliably);
# 9ef84268-d588-465a-a308-a864a43d0070 is the older "Current Daily Price" feed.
DATA_GOV_IN_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
DATA_GOV_IN_API_KEY=
JWT_SECRET=change-me
AUTH_REQUIRED=false
# "Sign in with Google": OAuth 2.0 client ID (type "Web application") from Google Cloud Console.
# Add your web app's origin (e.g. http://localhost:5173) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=
# Mobile app: the Android and iOS OAuth client IDs (comma-separated) so their sign-ins are accepted too.
GOOGLE_EXTRA_CLIENT_IDS=
OTP_DEV_MODE=true
STT_PROVIDER=none
# Keep voice recordings only when this is true AND the farmer turns it on in Settings.
STORE_VOICE_RECORDINGS=false
RECORDINGS_DIR=
# Optional S3-compatible storage for consented recordings (pip install -e ".[s3]")
S3_BUCKET=
S3_PREFIX=voice
S3_ENDPOINT_URL=
S3_REGION=
# Advisory search: char (default) | sentence-transformers (pip install -e ".[semantic]")
RETRIEVAL_EMBEDDER=char
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Server text-to-speech: none | google | azure
TTS_PROVIDER=none
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Push notifications for price alerts (Expo push service; token optional)
EXPO_ACCESS_TOKEN=
# Pilot monitoring: enables /admin/stats and /admin/export.csv (send X-Admin-Token)
ADMIN_TOKEN=
# Chat questions and answers are deleted after this many days (0 = keep forever)
HISTORY_RETENTION_DAYS=30
# Districts outside the pilot get labelled demo prices until real Agmarknet prices arrive (false in production)
DEMO_PRICES=true
# Slack/Discord/Teams webhook that is told when the daily price ingestion fails
OPS_ALERT_WEBHOOK_URL=
# Error reporting (pip install sentry-sdk)
SENTRY_DSN=
