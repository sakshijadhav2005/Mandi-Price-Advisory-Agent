# Copy to backend/.env and adjust.
# DATABASE_URL=postgresql+psycopg://mandi:mandi@localhost:5432/mandi
# Answer writer. LLM_PROVIDER=auto uses Claude when ANTHROPIC_API_KEY is set,
# otherwise a free local Ollama model when it is running, otherwise templates.
LLM_ENABLED=true
LLM_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
TOOL_BUDGET=6
STALE_AFTER_DAYS=3
# Pin "today" for demos against a fixed dataset (YYYY-MM-DD); empty = real date.
AS_OF_OVERRIDE=
DATA_GOV_IN_API_KEY=
JWT_SECRET=change-me
AUTH_REQUIRED=false
OTP_DEV_MODE=true
STT_PROVIDER=none
# Server text-to-speech: none | google | azure
TTS_PROVIDER=none
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Push notifications for price alerts (Expo push service; token optional)
EXPO_ACCESS_TOKEN=
# Pilot monitoring: enables /admin/stats and /admin/export.csv (send X-Admin-Token)
ADMIN_TOKEN=
# Error reporting (pip install sentry-sdk)
SENTRY_DSN=
